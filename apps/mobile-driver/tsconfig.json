{
  "extends": "@haramain/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "react-native": ["./shims/react-native.ts"],
      "expo-router": ["./shims/expo-router.ts"],
      "expo-secure-store": ["./shims/expo-secure-store.ts"],
      "expo-location": ["./shims/expo-location.ts"]
    }
  },
  "include": ["app/**/*.tsx", "app/**/*.ts", "lib/**/*.ts", "shims/**/*.ts"]
}
