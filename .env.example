# Haramain Ride — local development (never commit real secrets)
NODE_ENV=development
TZ=UTC

# Database
DATABASE_URL=postgresql://haramain:haramain@127.0.0.1:5432/haramain?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
COOKIE_SECURE=false

# Object storage (MinIO / S3-compatible). M1 falls back to local ./uploads if unset.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=haramain
OBJECT_STORAGE_SECRET_KEY=haramainsecret
OBJECT_STORAGE_BUCKET=haramain-docs
OBJECT_STORAGE_REGION=us-east-1

# Sandbox adapters — never claim live success
PAYMENT_PROVIDER=sandbox
SMS_PROVIDER=sandbox
EMAIL_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
WORKER_SECRET=dev-worker-secret
API_INTERNAL_URL=http://127.0.0.1:4000/api/v1

# Staging / go-live locks (M8) — never claim clearance by flipping these alone
APP_ENV=development
GO_LIVE_LOCKED=true
ALLOW_LIVE_PAYMENTS=false
ALLOW_LIVE_PROVIDERS=false
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_SEC=60

# Optional
MAPS_API_KEY=
SENTRY_DSN=

# App ports
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
